{
  "manifest_version": "0.3",
  "name": "mcp-server-starter",
  "version": "0.1.0",
  "description": "Production-grade MCP server starter: weather + notes example tools over stdio. Rename it and make it yours.",
  "author": {
    "name": "Your Name Here"
  },
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"]
    }
  },
  "compatibility": {
    "platforms": ["win32", "darwin"],
    "runtimes": {
      "node": ">=20.0.0"
    }
  }
}