{
  "name": "mcp-server-starter",
  "version": "0.1.0",
  "description": "Production-grade MCP server starter: stdio + Streamable HTTP, zod-validated tools, hermetic tests",
  "type": "module",
  "license": "MIT",
  "bin": { "mcp-server-starter": "dist/index.js" },
  "main": "dist/index.js",
